# Project-level ignore patterns

# Ignore objects, archives etc.
*.[oad]
autom4te.cache/
configure~

# Ignore files commonly generated by operating systems
.DS_Store
._*

# Ignore files generated from ci file parsing
*.decl.h
*.def.h
*.ci.stamp

# Ignore crash backtrace dumps written beside a crashing binary
*.btr

# Ignore Windows (MSVC) executables and the debug symbol files linked beside
# them (unix2nt_cc links with -DEBUG)
*.exe
*.pdb

# Ignore build artifacts
config_opts.sh
smart-build.log
charm-version.h
charm-version-git.h
bin
include
lib
lib_so
tmp
src/util/pup_f.f90
CMakeCache.txt
cmake_install.cmake
CMakeFiles
/Makefile
Charm++-prefix
src/arch/win/createlink.exe
/empty.cpp

# Ignore directories created from compilation
/reconverse-*

# Ignore cruft that would result from compiling charm example/test code
# Note this is negated inside src/arch to permit addition of new charmrun files in there
charmrun
ampirun
pgm
*.swp
bin
*.decl.h
*.def.h
tests/charm++/anytime_bcastred/bcastred
tests/charm++/qd/qdbench
tests/charm++/anytime_migration/migrate
tests/charm++/megatest/megatest
tests/charm++/migratable_threads/migthread
tests/charm++/simplearrayhello/hello

# Output of coverage/run.sh and coverage/report.sh
coverage/out/
