#!/bin/bash

CHARMBIN=$(cd "$(dirname "$0")" && pwd)
# NOTE: this reads the checkout's top-level bin/include symlinks, which
# point at the LAST build made in the tree. One build per checkout (as in
# CI, one job per arm); after switching arms in a shared tree, re-run
# `make -C <build> create_symlinks` or the wrong runtime's idiom is used.
# conv-mach-opt.sh is generated by the build, so it does not exist at lint
# time and there is nothing for shellcheck to follow.
# shellcheck source=/dev/null
[[ -f "$CHARMBIN/../include/conv-mach-opt.sh" ]] && . "$CHARMBIN/../include/conv-mach-opt.sh" 2>/dev/null

if [[ "$CMK_RECONVERSE" = "1" ]]
then
  # Reconverse run idiom: no charmrun. Single process is `./pgm +pe N`;
  # multi-process is `lcrun -n <procs> ./pgm +pe <total>` (set TESTRUN_PROCS).
  # Translate the classic conventions used by the tests' Makefiles: +pN or
  # "+p N" becomes +pe N; ++ppn and ++local are meaningless here and dropped.
  p=1; prog=""; args=(); expect_p=0; expect_ppn=0
  for a in "$@"; do
    if [[ $expect_p -eq 1 ]];   then p=$a; expect_p=0; continue; fi
    if [[ $expect_ppn -eq 1 ]]; then expect_ppn=0; continue; fi
    case "$a" in
      +p)        expect_p=1 ;;
      +p[0-9]*)  p=${a#+p} ;;
      ++ppn)     expect_ppn=1 ;;
      ++ppn*)    ;;
      ++local)   ;;
      *) if [[ -z "$prog" && ( "$a" == ./* || -x "$a" ) ]]; then prog="$a"; else args+=("$a"); fi ;;
    esac
  done
  if [[ -z "$prog" ]]; then echo "testrun: no program in args: $*" >&2; exit 1; fi
  procs=${TESTRUN_PROCS:-1}
  # Can't spread fewer PEs than processes; clamp. And reconverse requires
  # PEs divisible by processes -- skip indivisible combinations with a
  # warning (mirrors the classic ppn-divides-p courtesy skip).
  if [[ $procs -gt $p ]]; then procs=$p; fi
  if (( p % procs != 0 )); then
    echo "testrun(reconverse): +pe $p not divisible by $procs processes. Skipping the test."
    exit 0
  fi
  # No (DY)LD_LIBRARY_PATH prefix here: charmc records the directory it linked
  # libreconverse from as an RPATH in every binary, so programs run bare.
  # Setting it anyway would hide a regression in that -- the whole tier would
  # go on passing with the RPATH gone, which is how the gap survived this long.
  #
  # TESTRUN_LAUNCHER (site runs under a batch system): a launcher and its
  # flags, e.g. "srun --mpi=pmi2 -N2 --ntasks-per-node=1 -c2", used for EVERY
  # run including single-process ones, with "-n <procs>" appended. Inside a
  # Slurm allocation a reconverse binary must go through srun even alone:
  # LCI's bootstrap reads the inherited SLURM_NTASKS/SLURM_PROCID and waits
  # for peers that never come. Unset, the default is lcrun for multi-process
  # and a bare exec for single-process, as on a workstation or hosted CI.
  #
  # Address space randomization: a migratable thread (an AMPI rank) that
  # moves to another process, or is restored from a checkpoint by a new
  # process, resumes on a stack that holds return addresses into the program
  # and into libreconverse. Those addresses are only valid if the code is
  # loaded at the same address in every process, so on Linux the program is
  # run under "setarch <arch> -R", which sets the ADDR_NO_RANDOMIZE
  # personality flag before exec. The flag is inherited across fork and exec,
  # so for lcrun the prefix goes in front of lcrun and reaches every process
  # it starts. With TESTRUN_LAUNCHER (srun, mpirun) the prefix goes inside
  # the launch, after the launcher's arguments, because the launcher's daemon
  # (slurmd) starts the tasks on the compute nodes and they do not inherit a
  # flag set on the srun process. Classic charmrun did the same through
  # personality() and its ++va-randomization option; here
  # TESTRUN_VA_RANDOMIZATION=1 leaves randomization on. macOS is left alone:
  # it has no setarch, and randomization cannot be turned off from a script.
  # Where the personality call is refused (Docker's default seccomp profile
  # does not allow ADDR_NO_RANDOMIZE), setarch exits 1 without running the
  # command; a probe finds that out once, and the run then goes ahead with
  # randomization on, as classic charmrun did when its call failed.
  norand=()
  if [[ "$(uname -s)" = "Linux" && "$TESTRUN_VA_RANDOMIZATION" != "1" ]] \
     && command -v setarch > /dev/null 2>&1; then
    if setarch "$(uname -m)" -R true > /dev/null 2>&1; then
      norand=(setarch "$(uname -m)" -R)
    else
      echo "testrun(reconverse): setarch -R is not permitted here; running with address space randomization on" >&2
    fi
  fi
  if [[ -n "$TESTRUN_LAUNCHER" ]]; then
    read -r -a launcher <<< "$TESTRUN_LAUNCHER"
    cmd=("${launcher[@]}" -n "$procs" "${norand[@]}" "$prog" +pe "$p" "${args[@]}")
  elif [[ $procs -gt 1 ]]; then
    LCRUN="$CHARMBIN/lcrun"
    [[ -x "$LCRUN" ]] || LCRUN=lcrun
    cmd=("${norand[@]}" "$LCRUN" -n "$procs" "$prog" +pe "$p" "${args[@]}")
  else
    cmd=("${norand[@]}" "$prog" +pe "$p" "${args[@]}")
  fi
  echo "testrun(reconverse): ${cmd[*]}"
  time "${cmd[@]}"
  exit $?
fi

#check if ppn divides p
ppn_found=0
ppn=0
#parse the arguments to extract the ppn number
IFS=' ' read -r -a array <<< "$*"
for i in "${array[@]}"
do
  if [[ $ppn_found -eq 1 ]] ; then
    ppn=$i
    #echo "FOUND ppn:" $i
    break
  fi
  if [[ $i == *"ppn"* ]]; then
    ppn=$(echo "$i" | cut -d'n' -f 2)
    if [[ -z "$ppn" ]]
    then
        ppn_found=1
    else
        break
    fi
  fi

done

#now parse the arguments to run to find the p number
p=0
p_found=0
IFS=' ' read -r -a array <<< "$*"
for i in "${array[@]}"
do
  if [[ $p_found -eq 1 ]] ; then
    p=$i
    #echo "FOUND p:" $p
    break
  fi
  if [[ $i == "+p"* ]]; then
    p=$(echo "$i" | cut -d'p' -f 2)
    if [[ -z "$p" ]]
    then
        p_found=1
    else
        break
    fi
  fi
done

#if ppn is zero, don't do division test
if [[ $ppn -eq 0 ]] ; then
    time ./charmrun "$@"
else #division test
    #check if p divides ppn
    m=$((p % ppn))
    if [[ $p -ne 0 && $m -eq 0 ]] ; then
      #if it divides run the test
      time ./charmrun "$@"
    else
      #if it does not divide, give a warning and do not run
      echo "Warning: ppn does not divide p. Skipping the test."
    fi
fi
